// Test CONSTANT declarations and CHAR type
CONSTANT PI = 3.14159
CONSTANT MAX_USERS = 100
CONSTANT GREETING = "Hello, Cambridge!"
CONSTANT DELIMITER : CHAR = ':'
CONSTANT IS_ACTIVE = TRUE

DECLARE myChar : CHAR
myChar <- 'Z'

OUTPUT "PI = ", PI
OUTPUT "MAX_USERS = ", MAX_USERS
OUTPUT "GREETING = ", GREETING
OUTPUT "DELIMITER = ", DELIMITER
OUTPUT "myChar = ", myChar
OUTPUT "Active = ", IS_ACTIVE

FUNCTION CircleArea(r : REAL) RETURNS REAL
    CONSTANT LOCAL_PI = 3.14159
    RETURN LOCAL_PI * r * r
ENDFUNCTION

DECLARE area : REAL
area <- CircleArea(10.0)
OUTPUT "Area = ", area

PROCEDURE PrintHeader()
    CONSTANT HEADER = "=== REPORT ==="
    OUTPUT HEADER
ENDPROCEDURE

CALL PrintHeader()
