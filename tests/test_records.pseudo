TYPE Point
    DECLARE x : INTEGER
    DECLARE y : INTEGER
ENDTYPE

TYPE Student
    DECLARE name : STRING
    DECLARE score : INTEGER
ENDTYPE

DECLARE p1 : Point
DECLARE p2 : Point
p1.x <- 10
p1.y <- 20

// Value-copy semantics
p2 <- p1
p2.x <- 999

OUTPUT "p1:", p1.x, p1.y
OUTPUT "p2:", p2.x, p2.y

// Array of records
DECLARE students : ARRAY[1:3] OF Student
students[1].name <- "Alice"
students[1].score <- 95
students[2].name <- "Bob"
students[2].score <- 88
students[3].name <- "Charlie"
students[3].score <- 92

DECLARE i : INTEGER
FOR i <- 1 TO 3
    OUTPUT students[i].name, ":", students[i].score
NEXT i
