Students[2].Marks[5] <- 68

Students[3].ID <- 109
Students[3].Name <- "Charlie"
Students[3].Marks[1] <- 92
Students[3].Marks[2] <- 95
Students[3].Marks[3] <- 89
Students[3].Marks[4] <- 94
Students[3].Marks[5] <- 90

Students[4].ID <- 103
Students[4].Name <- "Diana"
Students[4].Marks[1] <- 35
