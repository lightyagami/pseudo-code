Students[5].Marks[4] <- 48
Students[5].Marks[5] <- 57


OUTPUT "CALCULATING STUDENT DATA..."
OUTPUT ""

FOR i <- 1 TO Count
    CalculateStudentData(Students[i])
NEXT i


OUTPUT "ORIGINAL STUDENTS"

FOR i <- 1 TO Count
    DisplayStudent(Students[i])
NEXT i


Highest <- Students[1].Marks[1]
Lowest <- Students[1].Marks[1]
Total <- 0

FOR i <- 1 TO Count
    FOR j <- 1 TO 5

        Total <- Total + Students[i].Marks[j]

        IF Students[i].Marks[j] > Highest THEN
            Highest <- Students[i].Marks[j]
        ENDIF

        IF Students[i].Marks[j] < Lowest THEN
            Lowest <- Students[i].Marks[j]
        ENDIF

    NEXT j
NEXT i

AverageAll <- Total / (Count * 5)

OUTPUT ""
OUTPUT "CLASS STATISTICS"
OUTPUT "Total Marks: ", Total
OUTPUT "Average Mark: ", AverageAll
OUTPUT "Highest Mark: ", Highest
OUTPUT "Lowest Mark: ", Lowest


OUTPUT ""
OUTPUT "SORTING STUDENTS..."

SortStudents(Students, Count)


OUTPUT ""
OUTPUT "STUDENTS SORTED BY AVERAGE"

FOR i <- 1 TO Count
    OUTPUT i, ". ", Students[i].Name, " - ", Students[i].Average, " - ", Students[i].Grade
NEXT i


OUTPUT ""
OUTPUT "SEARCH STUDENT BY ID"

SearchID <- 103

Found <- FALSE

FOR i <- 1 TO Count
    IF Students[i].ID = SearchID THEN
        Found <- TRUE
        OUTPUT "Student found at position ", i
        DisplayStudent(Students[i])
    ENDIF
NEXT i

IF Found = FALSE THEN
    OUTPUT "Student not found"
ENDIF


OUTPUT ""
OUTPUT "PRIME NUMBER TEST"

FOR i <- 1 TO 20
    IF IsPrime(i) THEN
        OUTPUT i, " is prime"
    ENDIF
NEXT i


OUTPUT ""
OUTPUT "RECURSIVE FACTORIAL TEST"

FOR i <- 1 TO 10
    OUTPUT i, "! = ", RecursiveFactorial(i)
NEXT i


OUTPUT ""
OUTPUT "CASE TEST"

Choice <- 3

CASE OF Choice
    1 : OUTPUT "Option One"
    2 : OUTPUT "Option Two"
    3 : OUTPUT "Option Three"
    4 : OUTPUT "Option Four"
    OTHERWISE : OUTPUT "Invalid Option"
ENDCASE
