TYPE Student
    DECLARE ID : INTEGER
    DECLARE Name : STRING
    DECLARE Marks : ARRAY[1:5] OF INTEGER
    DECLARE Average : REAL
    DECLARE Grade : CHAR
    DECLARE Passed : BOOLEAN
ENDTYPE

DECLARE Students : ARRAY[1:10] OF Student
DECLARE Count : INTEGER
DECLARE i : INTEGER
DECLARE j : INTEGER
DECLARE k : INTEGER
DECLARE Choice : INTEGER
DECLARE SearchID : INTEGER
DECLARE Found : BOOLEAN
DECLARE Total : INTEGER
DECLARE Highest : INTEGER
DECLARE Lowest : INTEGER
DECLARE Temp : INTEGER
DECLARE TempName : STRING
DECLARE TempAverage : REAL
DECLARE TempGrade : CHAR
DECLARE TempPassed : BOOLEAN
DECLARE AverageAll : REAL

FUNCTION CalculateAverage(Marks : ARRAY OF INTEGER) RETURNS REAL
    DECLARE Sum : INTEGER
    DECLARE i : INTEGER

    Sum <- 0

    FOR i <- 1 TO 5
        Sum <- Sum + Marks[i]
    NEXT i

    RETURN Sum / 5
ENDFUNCTION


FUNCTION CalculateGrade(Average : REAL) RETURNS CHAR
    IF Average >= 80 THEN
        RETURN "A"
    ELSE
        IF Average >= 70 THEN
            RETURN "B"
        ELSE
            IF Average >= 60 THEN
                RETURN "C"
            ELSE
                IF Average >= 50 THEN
                    RETURN "D"
                ELSE
                    RETURN "F"
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDFUNCTION


FUNCTION HasPassed(Marks : ARRAY OF INTEGER) RETURNS BOOLEAN
    DECLARE i : INTEGER

    FOR i <- 1 TO 5
        IF Marks[i] < 40 THEN
            RETURN FALSE
        ENDIF
    NEXT i

    RETURN TRUE
ENDFUNCTION


PROCEDURE CalculateStudentData(BYREF StudentData : Student)
    StudentData.Average <- CalculateAverage(StudentData.Marks)
    StudentData.Grade <- CalculateGrade(StudentData.Average)
    StudentData.Passed <- HasPassed(StudentData.Marks)
ENDPROCEDURE


PROCEDURE SwapStudents(BYREF A : Student, BYREF B : Student)
    DECLARE TempStudent : Student

    TempStudent <- A
    A <- B
    B <- TempStudent
ENDPROCEDURE


PROCEDURE SortStudents(BYREF Data : ARRAY OF Student, Size : INTEGER)
    DECLARE i : INTEGER
    DECLARE j : INTEGER
    DECLARE MaxIndex : INTEGER

    FOR i <- 1 TO Size - 1
        MaxIndex <- i

        FOR j <- i + 1 TO Size
            IF Data[j].Average > Data[MaxIndex].Average THEN
                MaxIndex <- j
            ELSE
                IF Data[j].Average = Data[MaxIndex].Average THEN
                    IF Data[j].ID < Data[MaxIndex].ID THEN
                        MaxIndex <- j
                    ENDIF
                ENDIF
            ENDIF
        NEXT j

        IF MaxIndex <> i THEN
            SwapStudents(Data[i], Data[MaxIndex])
        ENDIF
    NEXT i
ENDPROCEDURE


FUNCTION BinarySearch(Data : ARRAY OF Student, Size : INTEGER, TargetID : INTEGER) RETURNS INTEGER
    DECLARE Low : INTEGER
    DECLARE High : INTEGER
    DECLARE Mid : INTEGER

    Low <- 1
    High <- Size

    WHILE Low <= High
        Mid <- (Low + High) DIV 2

        IF Data[Mid].ID = TargetID THEN
            RETURN Mid
        ELSE
            IF Data[Mid].ID < TargetID THEN
                Low <- Mid + 1
            ELSE
                High <- Mid - 1
            ENDIF
        ENDIF
    ENDWHILE

    RETURN -1
ENDFUNCTION


FUNCTION RecursiveFactorial(N : INTEGER) RETURNS INTEGER
    IF N <= 1 THEN
        RETURN 1
    ELSE
        RETURN N * RecursiveFactorial(N - 1)
    ENDIF
ENDFUNCTION


FUNCTION IsPrime(N : INTEGER) RETURNS BOOLEAN
    DECLARE i : INTEGER

    IF N < 2 THEN
        RETURN FALSE
    ENDIF

    FOR i <- 2 TO N DIV 2
        IF N MOD i = 0 THEN
            RETURN FALSE
        ENDIF
    NEXT i

    RETURN TRUE
ENDFUNCTION


PROCEDURE DisplayStudent(StudentData : Student)
    OUTPUT "-----------------------------"
    OUTPUT "ID: ", StudentData.ID
    OUTPUT "Name: ", StudentData.Name
    OUTPUT "Marks:"

    FOR k <- 1 TO 5
        OUTPUT "Subject ", k, ": ", StudentData.Marks[k]
    NEXT k

    OUTPUT "Average: ", StudentData.Average
    OUTPUT "Grade: ", StudentData.Grade

    IF StudentData.Passed = TRUE THEN
        OUTPUT "Status: PASSED"
    ELSE
        OUTPUT "Status: FAILED"
    ENDIF
ENDPROCEDURE


Count <- 5

Students[1].ID <- 104
Students[1].Name <- "Alice"
Students[1].Marks[1] <- 78
Students[1].Marks[2] <- 85
Students[1].Marks[3] <- 91
Students[1].Marks[4] <- 67
